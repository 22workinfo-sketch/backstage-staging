# -----------------------------------------------------------------------------
# BackStage Environment Configuration (Example / Template)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or paste tokens in chat.
# -----------------------------------------------------------------------------

# Database Connection (Local Docker PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/backstage_db?schema=public"

# Admin Authentication Session Secret
# Generate a secure 32+ character random secret for production sessions
ADMIN_SESSION_SECRET="backstage-local-dev-secret-key-32chars-minimum-change-me"

# Initial Admin User Credentials (used by `npm run db:seed`)
ADMIN_DEFAULT_EMAIL="admin@local.test"
ADMIN_DEFAULT_PASSWORD="change_me_local_password_123"

# Telegram Bot Credentials
# Obtain from https://t.me/BotFather
# If left as placeholder, the app runs in mock mode for development and testing.
TELEGRAM_BOT_TOKEN="your_test_bot_token_from_botfather_here"

# Default Test Bot Metadata
BOT_DEFAULT_ID="00000000-0000-0000-0000-000000000001"
BOT_DEFAULT_NAME="Local Test Bot"
BOT_DEFAULT_USERNAME="local_test_bot"

# Application Environment
NODE_ENV="development"
PORT=3000
